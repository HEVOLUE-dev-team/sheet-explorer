# Copiez ce fichier en .env.local et renseignez votre clé.
# Clé d'API Google Cloud avec l'API Google Sheets activée (voir README).
GOOGLE_SHEETS_API_KEY=

# Bases de démonstration (CSV de /sample-data, ID « demo-… »).
# Toujours actives avec `npm run dev`. Décommentez pour les activer aussi en production.
# SHEETS_DEMO_MODE=true

# Numéro WhatsApp d'assistance (format international), pour le bouton d'aide.
# WHATSAPP_NUMBER=+237600000000
