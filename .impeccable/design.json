  "components": [
    {
      "name": "Bouton principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Action principale du back office : encre noire sur crème, 32px, coins 8px.",
      "html": "<button class=\"ds-btn-primary\">Ajouter une base</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:6px;height:32px;padding:0 10px;border:1px solid transparent;border-radius:var(--radius,0.5rem);background:var(--primary,oklch(0.22 0.004 70));color:var(--primary-foreground,oklch(0.97 0.006 85));font:500 14px Archivo,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:all .15s cubic-bezier(.4,0,.2,1)}.ds-btn-primary:hover{background:color-mix(in oklch,var(--primary,oklch(0.22 0.004 70)) 80%,transparent)}.ds-btn-primary:focus-visible{outline:none;box-shadow:0 0 0 3px color-mix(in oklch,var(--ring,oklch(0.25 0.008 70)) 50%,transparent)}.ds-btn-primary:active{transform:translateY(1px)}"
    },
    {
      "name": "Bouton contour",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Actions du bandeau d'outils (Filtrer, Colonnes, Exporter CSV).",
      "html": "<button class=\"ds-btn-outline\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M3 6h18M7 12h10M10 18h4\"/></svg>Filtrer</button>",
      "css": ".ds-btn-outline{display:inline-flex;align-items:center;gap:6px;height:32px;padding:0 10px;border:1px solid var(--border,oklch(0.88 0.01 80));border-radius:var(--radius,0.5rem);background:var(--background,oklch(0.968 0.006 85));color:var(--foreground,oklch(0.25 0.008 70));font:500 14px Archivo,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:all .15s}.ds-btn-outline:hover{background:var(--muted,oklch(0.935 0.008 80))}.ds-btn-outline:focus-visible{outline:none;box-shadow:0 0 0 3px color-mix(in oklch,var(--ring,oklch(0.25 0.008 70)) 50%,transparent)}"
    },
    {
      "name": "Boutons de la landing",
      "kind": "button",
      "refersTo": "landing-button-dark",
      "description": "Paire de la hero : bouton noir avec flèche et bouton contour blanc, 44px.",
      "html": "<div class=\"ds-l-actions\"><button class=\"ds-l-dark\">Connecter un Google Sheet <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M12 5l7 7-7 7\"/></svg></button><button class=\"ds-l-light\">Essayer avec la démo</button></div>",
      "css": ".ds-l-actions{display:flex;gap:8px;flex-wrap:wrap;padding:16px;background:oklch(0.968 0.006 85)}.ds-l-dark,.ds-l-light{display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 16px;border-radius:0.5rem;font:500 15px Archivo,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color .15s cubic-bezier(.4,0,.2,1)}.ds-l-dark{border:0;background:oklch(0.22 0.004 70);color:oklch(0.97 0.006 85)}.ds-l-dark:hover{background:oklch(0.3 0.004 70)}.ds-l-light{border:1px solid oklch(0.88 0.01 80);background:oklch(0.995 0.002 85);color:oklch(0.25 0.008 70)}.ds-l-light:hover{background:oklch(0.95 0.006 85)}.ds-l-dark:focus-visible,.ds-l-light:focus-visible{outline:none;box-shadow:0 0 0 2px oklch(0.968 0.006 85),0 0 0 4px oklch(0.25 0.008 70)}"
    },
    {
      "name": "Rail",
      "kind": "nav",
      "refersTo": "sidebar",
      "description": "Panneau sombre des bases et croisements ; l'entrée active s'inverse en crème.",
      "html": "<nav class=\"ds-rail\"><div class=\"ds-rail-label\">Bases</div><a class=\"ds-rail-item is-active\" href=\"#\"><span>Recouvrement</span><small>Démonstration · recovery</small></a><a class=\"ds-rail-item\" href=\"#\"><span>Clients</span><small>Démonstration · clients</small></a></nav>",
      "css": ".ds-rail{width:16rem;padding:12px 8px;background:var(--sidebar,oklch(0.22 0.004 70));color:var(--sidebar-foreground,oklch(0.93 0.008 85));font-family:Archivo,ui-sans-serif,system-ui,sans-serif}.ds-rail-label{padding:8px;font-size:11px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--sidebar-muted,oklch(0.72 0.01 80))}.ds-rail-item{display:grid;height:44px;align-content:center;padding:0 8px;border-radius:0.4rem;color:inherit;text-decoration:none;font-size:14px;line-height:1.2;outline:none}.ds-rail-item small{font-size:11px;opacity:.75}.ds-rail-item:hover{background:var(--sidebar-accent,oklch(0.3 0.004 70))}.ds-rail-item:focus-visible{box-shadow:0 0 0 2px var(--sidebar-ring,oklch(0.8 0.015 75))}.ds-rail-item.is-active{background:var(--sidebar-primary,oklch(0.968 0.006 85));color:var(--sidebar-primary-foreground,oklch(0.22 0.004 70));font-weight:600}"
    },
    {
      "name": "Tableau",
      "kind": "custom",
      "refersTo": "table-header",
      "description": "En-tête numéroté souligné d'encre, ligne sélectionnée pêche encadrée, tampons en colonne de correspondance.",
      "html": "<table class=\"ds-table\"><thead><tr><th>Correspondance</th><th><span class=\"ds-rub\">A·04</span> Prénom</th><th><span class=\"ds-rub\">A·05</span> Nom</th></tr></thead><tbody><tr><td><span class=\"ds-stamp ds-miss\">Absent de B</span></td><td>Léa</td><td>Laurent</td></tr><tr class=\"is-sel\"><td><span class=\"ds-stamp ds-found\">Trouvé dans B</span></td><td>Margaux</td><td>Mathieu</td></tr></tbody></table>",
      "css": ".ds-table{border-collapse:separate;border-spacing:0;background:oklch(0.968 0.006 85);color:oklch(0.25 0.008 70);font:13px Archivo,ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums}.ds-table th{height:40px;padding:0 10px;text-align:left;font-weight:600;border-bottom:1px solid color-mix(in oklch,oklch(0.25 0.008 70) 80%,transparent)}.ds-table td{padding:8px 10px;border-bottom:1px solid oklch(0.88 0.01 80)}.ds-table tbody tr{cursor:pointer}.ds-table tbody tr:hover td{background:oklch(0.935 0.008 80)}.ds-table tr.is-sel td{background:oklch(0.91 0.045 60);box-shadow:inset 0 1px 0 oklch(0.22 0.004 70),inset 0 -1px 0 oklch(0.22 0.004 70)}.ds-table tr.is-sel td:nth-child(n+2){font-weight:600}.ds-rub{display:inline-flex;align-items:center;justify-content:center;height:16px;min-width:24px;padding:0 4px;border:1px solid color-mix(in oklch,oklch(0.22 0.004 70) 60%,transparent);border-radius:3px;font:500 10px/1 'Geist Mono',ui-monospace,monospace;vertical-align:middle}.ds-stamp{display:inline-flex;padding:0 6px;border:1px solid;border-radius:2px;font-size:10px;line-height:16px;font-weight:600;letter-spacing:.025em;text-transform:uppercase;font-stretch:88%;white-space:nowrap}.ds-found{color:oklch(0.48 0.1 150)}.ds-miss{color:oklch(0.53 0.17 30)}"
    },
    {
      "name": "Rubrique",
      "kind": "chip",
      "refersTo": "rubric",
      "description": "Numéro de colonne encadré en Geist Mono ; encre pour A, ocre pour B.",
      "html": "<span class=\"ds-rubric\">A·06</span> <span class=\"ds-rubric ds-rubric-b\">B·01</span>",
      "css": ".ds-rubric{display:inline-flex;align-items:center;justify-content:center;height:16px;min-width:24px;padding:0 4px;border:1px solid color-mix(in oklch,var(--primary,oklch(0.22 0.004 70)) 60%,transparent);border-radius:3px;color:var(--primary,oklch(0.22 0.004 70));font:500 10px/1 'Geist Mono',ui-monospace,monospace;font-variant-numeric:tabular-nums}.ds-rubric-b{border-color:color-mix(in oklch,var(--source-b,oklch(0.5 0.11 50)) 70%,transparent);color:var(--source-b,oklch(0.5 0.11 50))}"
    },
    {
      "name": "Tampons",
      "kind": "chip",
      "refersTo": "stamp-found",
      "description": "État d'un croisement inscrit sur la ligne ; version fiche plus grande et inclinée.",
      "html": "<span class=\"ds-st ds-st-found\">Trouvé dans B</span> <span class=\"ds-st ds-st-miss\">Absent de B</span> <span class=\"ds-st ds-st-miss ds-st-lg\">Absent de B</span>",
      "css": ".ds-st{display:inline-flex;align-items:center;padding:0 6px;border:1px solid;border-radius:2px;font:600 10px/16px Archivo,ui-sans-serif,sans-serif;letter-spacing:.025em;text-transform:uppercase;font-stretch:88%;white-space:nowrap}.ds-st-found{color:var(--success,oklch(0.48 0.1 150))}.ds-st-miss{color:var(--destructive,oklch(0.53 0.17 30))}.ds-st-lg{border-width:2px;padding:2px 8px;font-size:12px;transform:rotate(-1deg)}"
    },
    {
      "name": "Cases de la fiche",
      "kind": "card",
      "refersTo": "record-field",
      "description": "Champs d'une ligne en grille de cases à filet, clé comparée contournée de vert.",
      "html": "<div class=\"ds-rec\"><div class=\"ds-rec-band\">Base A · Recouvrement</div><dl class=\"ds-rec-grid\"><div class=\"ds-rec-f\"><dt><span class=\"ds-r\">A·05</span> Nom</dt><dd>Lefèvre</dd></div><div class=\"ds-rec-f is-key\"><dt><span class=\"ds-r\">A·06</span> Téléphone <b>clé</b></dt><dd>06 39 98 98 68</dd></div><div class=\"ds-rec-f is-wide\"><dt><span class=\"ds-r\">A·08</span> Email</dt><dd>zoe.lefevre@example.com</dd></div></dl></div>",
      "css": ".ds-rec{width:340px;background:oklch(0.968 0.006 85);color:oklch(0.25 0.008 70);font-family:Archivo,ui-sans-serif,sans-serif}.ds-rec-band{padding:4px 8px;background:oklch(0.935 0.01 80);color:oklch(0.32 0.01 70);font-size:11px;font-weight:600;letter-spacing:.05em;text-transform:uppercase}.ds-rec-grid{display:grid;grid-template-columns:1fr 1fr;margin:0;border-top:1px solid oklch(0.8 0.015 75);border-left:1px solid oklch(0.8 0.015 75)}.ds-rec-f{min-height:52px;padding:6px 10px 8px;border-right:1px solid oklch(0.8 0.015 75);border-bottom:1px solid oklch(0.8 0.015 75)}.ds-rec-f:hover{background:oklch(0.94 0.008 80)}.ds-rec-f.is-wide{grid-column:span 2}.ds-rec-f.is-key{background:color-mix(in oklch,oklch(0.48 0.1 150) 8%,transparent);outline:2px solid oklch(0.48 0.1 150);outline-offset:-2px}.ds-rec-f dt{display:flex;align-items:center;gap:6px;font-size:11px;color:oklch(0.47 0.01 70)}.ds-rec-f dt b{color:oklch(0.48 0.1 150)}.ds-rec-f dd{margin:4px 0 0;font-size:14px}.ds-r{display:inline-flex;height:16px;min-width:24px;padding:0 4px;align-items:center;justify-content:center;border:1px solid color-mix(in oklch,oklch(0.22 0.004 70) 60%,transparent);border-radius:3px;color:oklch(0.22 0.004 70);font:500 10px/1 'Geist Mono',ui-monospace,monospace}"
    },
    {
      "name": "Cadre vidéo de la landing",
      "kind": "card",
      "refersTo": "landing-video-frame",
      "description": "Vitrine de la démonstration : figure à 8px, anneau de filet, ombre unique, légende « Données fictives ».",
      "html": "<figure class=\"ds-vframe\"><div class=\"ds-vframe-media\"></div><figcaption><span>Coller un lien, chercher une personne, ouvrir sa fiche, croiser deux bases.</span><span class=\"ds-vframe-tag\">Données fictives</span></figcaption></figure>",
      "css": ".ds-vframe{margin:24px;overflow:hidden;border-radius:0.5rem;background:oklch(0.995 0.002 85);box-shadow:0 0 0 1px oklch(0.88 0.01 80),0 30px 60px -40px rgb(40 30 20/.45)}.ds-vframe-media{aspect-ratio:1280/712;background:oklch(0.935 0.008 80)}.ds-vframe figcaption{display:flex;justify-content:space-between;gap:8px;padding:12px 16px;border-top:1px solid oklch(0.88 0.01 80);font:13px Archivo,ui-sans-serif,sans-serif;color:oklch(0.48 0.01 70)}.ds-vframe-tag{font:11px 'Geist Mono',ui-monospace,monospace;letter-spacing:.05em;text-transform:uppercase}"
    },
    {
